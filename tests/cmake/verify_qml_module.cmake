if(NOT EXISTS "${QMLDIR_PATH}")
    message(FATAL_ERROR "Generated QML module descriptor is missing: ${QMLDIR_PATH}")
endif()

file(READ "${QMLDIR_PATH}" qml_module_descriptor)
foreach(qml_type IN ITEMS AsterTheme DesktopWorkspace DesktopButton DesktopField DeviceInspector)
    string(FIND "${qml_module_descriptor}" "${qml_type} 1.0" type_position)
    if(type_position EQUAL -1)
        message(FATAL_ERROR "Desktop QML type is not registered: ${qml_type}")
    endif()
endforeach()
file(READ "${MAIN_QML_PATH}" main_qml)
string(FIND "${main_qml}" "DesktopWorkspace {" workspace_position)
if(workspace_position EQUAL -1)
    message(FATAL_ERROR "Main must instantiate the desktop workspace")
endif()
get_filename_component(qml_root "${MAIN_QML_PATH}" DIRECTORY)
file(READ "${qml_root}/controls/DesktopButton.qml" button_qml)
string(FIND "${button_qml}" "../assets/icons/" icon_position)
if(icon_position EQUAL -1 OR NOT EXISTS "${qml_root}/assets/icons/settings-ui.svg")
    message(FATAL_ERROR "Desktop controls must resolve the unified icons")
endif()

if(EXISTS "${qml_root}/assets/figma" OR NOT EXISTS "${qml_root}/assets/images/preview.jpg")
    message(FATAL_ERROR "Images and icons must use the unified asset directories")
endif()
get_filename_component(project_root "${qml_root}" DIRECTORY)
file(READ "${project_root}/CMakeLists.txt" build_source)
file(GLOB icons "${qml_root}/assets/icons/*.svg")
foreach(icon IN LISTS icons)
    get_filename_component(icon_name "${icon}" NAME)
    if(NOT icon_name MATCHES "^[a-z0-9-]+\\.svg$")
        message(FATAL_ERROR "Icon names must use lower-kebab-case: ${icon_name}")
    endif()
    string(FIND "${build_source}" "qml/assets/icons/${icon_name}" resource_position)
    if(resource_position EQUAL -1)
        message(FATAL_ERROR "Icon is not bundled: ${icon_name}")
    endif()
endforeach()
file(GLOB_RECURSE asset_sources "${qml_root}/*.qml")
list(APPEND asset_sources "${project_root}/src/main.cpp" "${project_root}/CMakeLists.txt")
foreach(source IN LISTS asset_sources)
    file(READ "${source}" source_text)
    string(FIND "${source_text}" "assets/figma/" legacy_position)
    if(NOT legacy_position EQUAL -1)
        message(FATAL_ERROR "Legacy asset reference in ${source}")
    endif()
endforeach()
